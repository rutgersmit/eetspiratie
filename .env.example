# Copy to .env (for docker compose) or .env.local (for npm run dev).
# Never commit the real file: this repository is public.

# The single login for the app
AUTH_USERNAME=rutger
AUTH_PASSWORD=change-me-to-a-long-password

# Random secret used to sign the session cookie, at least 32 characters.
# Generate one with: openssl rand -base64 32
# Changing it (or the username/password) logs out every device.
AUTH_SECRET=

# Optional. By default the session cookie is marked Secure when the request
# arrives via HTTPS (X-Forwarded-Proto: https from a reverse proxy).
# Force it with true/false if needed.
# COOKIE_SECURE=

# Optional, for npm run dev. Defaults to ./data. In Docker it is /app/data.
# DATA_DIR=./data
